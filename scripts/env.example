# ============================================================
#  Smart QC — .env.local SHABLON
#  IT Guruhi: bu faylni nusxalab .env.local deb saqlang
#  va qiymatlarni o'zingizning server ma'lumotlariga moslashtiring
# ============================================================

# PostgreSQL ulanish manzili
# Format: postgresql://FOYDALANUVCHI:PAROL@SERVER_IP:PORT/DB_NOMI
DATABASE_URL=postgresql://postgres:PAROL@localhost:5432/smart_qc

# Misol (server IP bilan):
# DATABASE_URL=postgresql://postgres:MyPassword123@192.168.1.100:5432/smart_qc

# SSL rejimi:
#   false   → lokal / ichki server PostgreSQL (SSL sozlanmagan) — ODATDA SHU
#   require → cloud (Railway, Supabase va h.k.)
# Lokal serverda MAJBURIY 'false' qiling, aks holda ulanish ishlamaydi!
DATABASE_SSL=false
